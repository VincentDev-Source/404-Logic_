generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("POSTGRES_PRISMA_DATABASE_URL")
}

model Report {
  id          Int      @id @default(autoincrement())
  title       String
  category    String
  description String
  status      String   @default("Menunggu")
  location    String?
  imageUrl    String?
  upvotes     Int      @default(0)
  createdAt   DateTime @default(now())
}